generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  emailVerified      DateTime?
  name               String?
  image              String?
  passwordHash       String?
  role               String         @default("user") // user | admin
  notificationPrefs  String         @default("{\"goals\":true,\"cards\":false,\"kickoff\":true,\"finalWhistle\":true,\"lineups\":true,\"substitutions\":false}")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  accounts           Account[]
  sessions           Session[]
  favorites          Favorite[]
  notifications      Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id         String   @id @default(cuid())
  externalId Int      @unique
  name       String
  logoUrl    String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  players    Player[]
  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")
  standings  Standing[]
}

model League {
  id         String     @id @default(cuid())
  externalId Int        @unique
  name       String
  logoUrl    String?
  country    String?
  season     Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  fixtures   Fixture[]
  standings  Standing[]
}

model Player {
  id          String   @id @default(cuid())
  externalId  Int      @unique
  name        String
  photoUrl    String?
  nationality String?
  position    String?
  age         Int?
  number      Int?
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      FixtureEvent[]
}

model Fixture {
  id          String              @id @default(cuid())
  externalId  Int                 @unique
  leagueId    String?
  league      League?             @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  season      Int?
  homeTeamId  String?
  homeTeam    Team?               @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId  String?
  awayTeam    Team?               @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  homeScore   Int?
  awayScore   Int?
  status      String?
  elapsed     Int?
  startTime   DateTime?
  venue       String?
  round       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  events      FixtureEvent[]
  statistics  FixtureStatistic[]

  @@index([externalId])
  @@index([startTime])
  @@index([status])
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model FixtureEvent {
  id         String   @id @default(cuid())
  fixtureId  String
  fixture    Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamId     String?
  playerId   String?
  player     Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  type       String
  detail     String?
  minute     Int?
  extra      Int?
  playerName String?
  assistName String?
  createdAt  DateTime @default(now())

  @@index([fixtureId])
}

model FixtureStatistic {
  id             String   @id @default(cuid())
  fixtureId      String
  fixture        Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  teamExternalId Int?
  possession     Int?
  shots          Int?
  shotsOnTarget  Int?
  corners        Int?
  fouls          Int?
  offsides       Int?
  passes         Int?
  passAccuracy   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([fixtureId, teamExternalId])
}

model Standing {
  id             String   @id @default(cuid())
  leagueId       String
  league         League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season         Int
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position       Int
  played         Int      @default(0)
  wins           Int      @default(0)
  draws          Int      @default(0)
  losses         Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  goalDifference Int      @default(0)
  points         Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([leagueId, season, teamId])
  @@index([leagueId, season])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // team | league | fixture | player
  entityId  Int
  createdAt DateTime @default(now())

  @@unique([userId, type, entityId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SyncLog {
  id              String   @id @default(cuid())
  resource        String
  status          String
  message         String?
  recordsAffected Int      @default(0)
  createdAt       DateTime @default(now())
}
